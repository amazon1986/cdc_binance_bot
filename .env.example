# ==============================================================================
# CDC Action Zone V2 - Binance Trading Bot Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.

# 1. Binance API Credentials
BINANCE_API_KEY="YOUR_BINANCE_API_KEY_HERE"
BINANCE_API_SECRET="YOUR_BINANCE_API_SECRET_HERE"
BINANCE_IS_TESTNET="false"
BINANCE_MARKET_TYPE="FUTURES"
BINANCE_MARGIN_TYPE="ISOLATED"

# 2. Telegram Bot Notification Credentials
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"
TELEGRAM_ENABLED="true"

# 3. Google Gemini AI API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 4. Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# 5. User Authentication (Username & Password for Login)
AUTH_USERNAME="amazon1986"
AUTH_PASSWORD="your_password_here"
